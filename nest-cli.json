{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/main-service/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": "rspack",
    "tsConfigPath": "apps/main-service/tsconfig.app.json",
    "assets": [
      {
        "include": "../../../proto/**/*",

        "watchAssets": true
      }
    ]
  },
  "monorepo": true,
  "root": "apps/main-service",
  "projects": {
    "auth-service": {
      "type": "application",
      "root": "apps/auth-service",
      "entryFile": "main",
      "sourceRoot": "apps/auth-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/auth-service/tsconfig.app.json"
      }
    },
    "main-service": {
      "type": "application",
      "root": "apps/main-service",
      "entryFile": "main",
      "sourceRoot": "apps/main-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/main-service/tsconfig.app.json",
        "assets": [
          {
            "include": "views/**/*",
            "outDir": "dist/apps/seflinkbackend/views",
            "watchAssets": true
          }
        ]
      }
    }
  }
}
